TRAINMIND_ENV=dev
TRAINMIND_HOST=0.0.0.0
TRAINMIND_PORT=8010
TRAINMIND_BUSINESS_BASE_URL=http://127.0.0.1:8000
TRAINMIND_REQUEST_TIMEOUT_SECONDS=8
TRAINMIND_MCP_ENABLED=false
TRAINMIND_MCP_SERVER_URL=http://127.0.0.1:8011/sse
TRAINMIND_KNOWLEDGE_DIR=../knowledge
TRAINMIND_RAG_TOP_K=4
TRAINMIND_RAG_PGVECTOR_ENABLED=false
TRAINMIND_RAG_POSTGRES_DSN=postgresql://trainmind:CHANGE_ME@127.0.0.1:5432/trainmind
TRAINMIND_RAG_EMBEDDING_MODEL=text-embedding-v4
TRAINMIND_RAG_EMBEDDING_DIMENSION=1024
TRAINMIND_LLM_ENABLED=false
TRAINMIND_LLM_MODEL=deepseek-chat
TRAINMIND_LLM_BASE_URL=https://api.deepseek.com
TRAINMIND_LLM_API_KEY=
TRAINMIND_MAX_RESULTS=5
TRAINMIND_LLM_TIMEOUT_SECONDS=60
TRAINMIND_SESSION_TTL_MINUTES=60
TRAINMIND_SESSION_STORE=hybrid
TRAINMIND_REDIS_URL=redis://127.0.0.1:6379/0
TRAINMIND_REDIS_KEY_PREFIX=trainmind:agent:conversation
TRAINMIND_MYSQL_URL=mysql+asyncmy://root:CHANGE_ME@127.0.0.1:3306/business?charset=utf8mb4
